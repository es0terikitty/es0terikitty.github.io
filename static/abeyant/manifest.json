{
  "manifest_version": 3,
  "name": "Abeyant - A resurgent",
  "short_name": "Abeyant",
  "version": "1.0.0",
  "description": "A retro terminal-style new tab page with live grid, search, and custom shortcuts.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "favicon", "search"]
}
